<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>2025 Таблица</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 2rem;
    }

    h2 {
      margin-bottom: 1rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #333;
      padding: 8px 12px;
      text-align: center;
    }

    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 0.9em;
      white-space: nowrap;
    }

    td {
      white-space: nowrap;
    }
  </style>
</head>
<body>

