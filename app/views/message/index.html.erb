<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>2025 — Activity messages</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #333;
      padding: 8px 12px;
      text-align: center;
      white-space: nowrap;
    }

    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 0.9em;
    }

    .actions a, .actions form {
      display: inline-block;
      margin: 0 4px;
    }
    <title>MyApp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      body {
        background-color: <%= @setting&.theme == 'dark' ? '#222' : '#fff' %>;
        color: <%= @setting&.theme == 'dark' ? '#f0f0f0' : '#000' %>;
        font-family: <%= @setting&.font || 'Arial' %>;
        font-size: <%= @setting&.font_size || '16px' %>;
      }
    </style>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>

  <h2>2025 — Activity messages</h2>

  <table>
    <thead>
      <tr>
        <th>Time spendings</th>
        <th>Activity</th>
        <th>Begining date</th>
        <th>Ending date</th>
        <th>Duration (min)</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="messages">
      <%= turbo_frame_tag "new_message" do %>
        <%= render "form", message: Message.new %>
      <% end %>

      <% @messages.each do |message| %>
        <%= turbo_frame_tag dom_id(message) do %>
          <tr>
            <td>
              <span class="tag time_spend_type-<%= message.time_spend_type.parameterize(separator: '_') %>">
                <%= message.time_spend_type %>
              </span>
            </td>
            <td>
              <span class="tag activity-<%= message.activity.parameterize(separator: '_') %>">
                <%= message.activity %>
              </span>
            </td>
            <td><%= message.start_time.strftime("%d/%m/%Y %H:%M") if message.start_time %></td>
            <td><%= message.end_time.strftime("%d/%m/%Y %H:%M") if message.end_time %></td>
            <td>
              <% if message.start_time && message.end_time %>
                <%= ((message.end_time - message.start_time) / 60).to_i %>
              <% else %>
                -
              <% end %>
            </td>
            <td class="actions">
              <%= link_to "Edit", edit_message_path(message), data: { turbo_frame: dom_id(message) }, class: "text-blue-500" %>
              <%= button_to message_path(message), method: :delete, form: { data: { turbo_confirm: "Are you sure?" }, class: "inline" }, class: "text-red-500 ml-2" do %>
                Delete
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

</body>
</html>