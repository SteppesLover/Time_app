<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Settings</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
    }

    .settings-container {
      max-width: 600px;
      margin: auto;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }

    h2 {
      text-align: center;
      margin-bottom: 25px;
    }

    .setting {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
    }

    input[type="text"],
    input[type="email"],
    select {
      width: 100%;
      padding: 10px;
      border: none;
      border-radius: 5px;
    }

    input[type="checkbox"] {
      margin-right: 8px;
    }

    .button {
      display: block;
      width: 100%;
      padding: 12px;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 16px;
      cursor: pointer;
    }


    .section-title {
      margin-top: 30px;
      font-size: 18px;
      border-bottom: 1px solid #333;
      padding-bottom: 5px;
    }
  </style>
</head>
<body>

  <div class="settings-container">
    <h2>Site Settings</h2>

    <div class="setting">
      <label for="username">Username</label>
      <input type="text" id="username" value="Evangelion">
    </div>

    <div class="setting">
      <label for="email">Email Address</label>
      <input type="email" id="email" value="user@example.com">
    </div>

    <div class="setting">
      <label for="theme">Theme</label>
      <select id="theme">
        <option value="dark" selected>Dark</option>
        <option value="light">Light</option>
        <option value="auto">Auto</option>
      </select>
    </div>

    <div class="setting">
      <label>
        <input type="checkbox" checked>
        Enable Notifications
      </label>
    </div>

    <div class="setting">
      <label>
        <input type="checkbox">
        Show Completed Tasks
      </label>
    </div>

    <div class="setting">
      <label for="lang">Language</label>
      <select id="lang">
        <option value="ru">Русский</option>
        <option value="en" selected>English</option>
      </select>
    </div>

    <button class="button">Save Settings</button>
  </div>

</body>
</html>